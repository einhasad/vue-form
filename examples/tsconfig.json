{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "paths": {
      "@einhasad/vue-form": ["../src/index.ts"],
      "@einhasad/vue-form/headless": ["../src/headless/index.ts"],
      "@einhasad/vue-form/ant-design": ["../src/ant-design/index.ts"]
    }
  },
  "include": ["src/**/*", "src/**/*.vue", "env.d.ts"]
}
