{
  "name": "@einhasad-vue/vue-form",
  "version": "0.4.0",
  "description": "Fully headless Vue 3 form library. Composables and validator factories — bring your own UI. Framework-free Form/Field classes at the ./headless subpath; optional Ant Design Vue adapter at ./ant-design.",
  "author": "Dima Popov",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./headless": {
      "import": {
        "types": "./dist/headless.d.ts",
        "default": "./dist/headless.mjs"
      },
      "require": {
        "types": "./dist/headless.d.cts",
        "default": "./dist/headless.cjs"
      }
    },
    "./ant-design": {
      "import": {
        "types": "./dist/ant-design.d.ts",
        "default": "./dist/ant-design.mjs"
      },
      "require": {
        "types": "./dist/ant-design.d.cts",
        "default": "./dist/ant-design.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "keywords": [
    "vue",
    "vue3",
    "form",
    "forms",
    "validation",
    "headless",
    "composables",
    "typescript",
    "ant-design-vue"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/einhasad/vue-form.git"
  },
  "bugs": {
    "url": "https://github.com/einhasad/vue-form/issues"
  },
  "homepage": "https://einhasad.github.io/vue-form/",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:examples": "npm run typecheck --workspace examples",
    "lint": "eslint src tests examples/src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run typecheck:examples && npm run test:coverage && npm run build"
  },
  "peerDependencies": {
    "ant-design-vue": "^3.2.0 || ^4.0.0",
    "dayjs": "^1.11.0",
    "vue": "^3.3"
  },
  "peerDependenciesMeta": {
    "ant-design-vue": {
      "optional": true
    },
    "dayjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.4.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vitest/coverage-v8": "^1.6.1",
    "@vue/test-utils": "^2.4.4",
    "ant-design-vue": "^4.2.6",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "jsdom": "^24.0.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^5.1.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^1.2.0",
    "vue": "^3.4.0",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^2.0.29"
  },
  "workspaces": [
    "examples"
  ]
}
